{
  "manifest_version": 3,
  "name": "Azure DevOps Task Generator",
  "description": "Generate a saved series of Azure DevOps Tasks under a work item.",
  "version": "0.1.0",
  "icons": {
    "16": "assets/toolbar-icon-16.png",
    "32": "assets/toolbar-icon-32.png",
    "48": "assets/toolbar-icon-48.png",
    "128": "assets/toolbar-icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "assets/toolbar-icon-16.png",
      "32": "assets/toolbar-icon-32.png",
      "48": "assets/toolbar-icon-48.png",
      "128": "assets/toolbar-icon-128.png"
    },
    "default_popup": "popup.html",
    "default_title": "Task Generator"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://dev.azure.com/*",
    "https://*.visualstudio.com/*"
  ]
}
